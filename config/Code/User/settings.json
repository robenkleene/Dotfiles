{
    // Don't prompt for trust every time a workspace is opened
    "security.workspace.trust.enabled": false,
    // Don't show a welcome page on startup
    // `"newUntitledFile"` Start with an untitled file
    // `"none"`: Start with nothing
    "workbench.startupEditor": "newUntitledFile",
    // Automatically open a parent git repository when opening a subfolder
    // (By default this prompts)
    "git.openRepositoryInParentFolders": "always",
    // Fix option keys (e.g., to move by word) in the integrated terminal
    "terminal.integrated.macOptionIsMeta": true,
    "[markdown]": {
        "editor.rulers": [],
        "editor.wordWrap": "on",
        // Auto-complete is now off by default in Markdown mode, this turns it on
        // "editor.quickSuggestions": {
        //     "other": "on",
        //     "comments": "on",
        //     "strings": "on"
        // },
        // Don't highlight the current word, which is distracting and not useful
        // in prose
        "editor.occurrencesHighlight": "off",
        // Don't suggest words from the document
        "editor.wordBasedSuggestions": "off"
    },
    "[rust]": {
        "editor.rulers": [100],
    },
    // Prioritized expanding snippets with tab
    // Doc string for this option says "Works best when 'quickSuggestions'
    // aren't enabled." This is just because tab for autocomplete takes
    // precedence over tab for expanding snippets. I.e., so having this global
    // won't conflict with autocomplete, but autocomplete will take precedence
    // when it's visible.
    "editor.tabCompletion": "onlySnippets",
    // Don't suggest words from the document
    "editor.wordBasedSuggestions": "off",
    // When pasting images into Markdown files, prefix the resulting image name
    // with the document name. This makes it easier to find the created images
    // later.
    "markdown.copyFiles.destination": {
        "**/*.md": "${documentBaseName}-${fileName}"
    },
    // You can't turn off fuzzy matching in autocomplete (so `br` will always
    // match `bar`). But turning off `filterGraceful` turns off misspelling
    // corrections (so `bra` won't match `bar`).
    "editor.suggest.filterGraceful": false,
    // Copy as plain text
    "editor.copyWithSyntaxHighlighting": false,
    "files.defaultLanguage": "markdown",
    // Disable prompt for opening files via URL
    "security.promptForLocalFileProtocolHandling": false,
    // Touched by `CodeLLDB`
    "lldb.library": "/Applications/Xcode.app/Contents/SharedFrameworks/LLDB.framework/Versions/A/LLDB",
    "lldb.launch.expressions": "native",
    // Disable hints in the editor, e.g., `ask GitHub Copilot`
    "workbench.editor.empty.hint": "hidden",
    // Disable hints in the terminal, e.g., `ask GitHub Copilot`
    "terminal.integrated.initialHint": false,
    // Don't show `GitHub Copilot` autocompletion suggestions
    // Old option, deprecated?
    // "github.copilot.editor.enableAutoCompletions": false,
    "editor.inlineSuggest.enabled": false,
    "update.showReleaseNotes": false,
    // Don't re-open windows when opening VS Code
    // Unfortunately, open files in a Workspace will still be opened when a
    // Workspace is re-opened and that cannot be turned off
    // Adding this back, it's useful when language servers aren't working to
    // quickly restore everything
    // "window.restoreWindows": "none",
    // Disable extension recommendations popup
    // Recommendations can still be seen with the `Extensions: Show Recommended
    // Extensions` command
    "extensions.ignoreRecommendations": true,
    "workbench.remoteIndicator.showExtensionRecommendations": false,
    // Open files in a new window, e.g., from the Finder
    "window.openFilesInNewWindow": "on",
    "editor.fontSize": 13,
    // Use the medium variant
    // "editor.fontWeight": "500",
    "editor.fontFamily": "'SF Mono', Menlo, Monaco, 'Courier New', monospace",
    "terminal.integrated.fontSize": 13,
    // Don't automatically insert closing pairs
    // This makes freeform text manipulation difficult, e.g., if a closing pair
    // has already been entered, adding the opening pair will then
    // incorrectly enter the closing pair
    "editor.autoClosingBrackets": "never",
    // This setting allows selecting text then entering a delimiter to surround
    // that text
    // "editor.autoSurround": "never",
    // Don't show the sidebar on the right by default
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    // Don't open files or expand directories in the Explorer in a single click
    // This makes it easier to click then traversing folders and makes the
    // keyboard shortcut (`⌃↩`) to open a file to the side hard to use
    // This has the unintended side effect of disabling the preview mode that VS
    // Code normally opens files in (when the filename is in italics)
    // "workbench.list.openMode": "doubleClick",
    // "workbench.tree.expandMode": "doubleClick",
    "editor.autoClosingQuotes": "never",
    "editor.autoSurround": "never",
    "editor.rulers": [80],
    // The minimap isn't useful enough to always have on
    "editor.minimap.enabled": false,
    // Don't ask for confirmation before deleting a file
    "explorer.confirmDelete": false,
    // Code Spell Checker
    // Delay the spell check to avoid immediately marking the word being typed
    // as misspelled
    "cSpell.spellCheckDelayMs": 3000,
    // Don't show notifications when `cSpell` is disabling spell checking for
    // performance reasons (this often happens when opening a long log file)
    "cSpell.enabledNotifications": {
        "Maximum Word Length Exceeded": false,
        "Lines too Long": false,
        "Average Word Length too Long": false
    },
    "cSpell.languageSettings": [
        {
            "languageId": "markdown",
            // Don't spell check code blocks and inline code
            "ignoreRegExpList": [
                "/^\\s*```[\\s\\S]*?^\\s*```/gm",
                "/`[^`]+`/g"
            ]
        }
    ],
    // lldb
    // Don't show update notifications
    "lldb.suppressUpdateNotifications": true,
    // Use light theme becauce it makes it easier to cut and paste rendered
    // Markdown to rich text
    // "workbench.colorTheme": "Light Modern",
    // Don't compact folders in the tree view
    // This makes trying to drag-and-drop folders to the correct arrangement
    // confusing
    "explorer.compactFolders": false,
    // Don't confirm every time a file is drag-and-dropped
    "explorer.confirmDragAndDrop": false,
    // The Explorer's full path tooltip can't be turned off, so delay it
    // `workbench.hover.delay` defaults to `1500` on macOS
    "workbench.hover.delay": 3000,
    // Hade the "Show code actions" lightbulb, code actions can still be
    // triggered with `⌘I`
    "editor.lightbulb.enabled": "off",
    "cSpell.userWords": [
        "Ableton",
        "polyrhythm",
        "polyrhythms"
    ],
    "workbench.colorTheme": "Light 2026"
}
