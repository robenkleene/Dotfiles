# keybind = global:opt+escape=toggle_quick_terminal

# font-family = "Berkeley Mono"
# font-family = "Consolas"

# font-size = 13

font-family = "SF Mono"

# Old adjustments probably not necessary anymore
# font-style = "Medium"
# adjust-cell-width = "-5%"
# adjust-cell-height = "3%"

# Font smoothing with SF Mono looks better on large Retina monitors, without it
# the strokes look too thin
font-thicken = true
# adjust-cell-width = "-3%"
adjust-cell-height = "12%"

# Show default native toolbar
macos-titlebar-style = native
# Without `window-theme = system`, the terminal theme is sampled for a toolbar color
window-theme = system
theme = robenkleene

# Initial window size in grid cells, without this the last window size is used
window-width = 80
window-height = 24

macos-dock-drop-behavior = new-window

# New windows start in home, new tabs and splits still inherit the current
# directory (the default)
window-inherit-working-directory = false
working-directory = home

# - `system`: Play default audio
# - `audio`: Play a custom sound
# - `title`: Put a bell in the title bar
# - `attention`: Bounce the app icon
# - `border`: Put a border around the window
# Simplifying to just `title` because the others are distracting if not waiting
# for a job to finish
bell-features = title

# The blur setting has trouble sticking on 1.1.3
# Try again on a new version
# background-opacity = 0.9
# background-blur = true

# Cursor
# `shell-integration` overrides the cursor
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

# Set number of lines to scroll per mouse wheel tick
# The default is `3` which results in `15` lines scrolling in `tmux`
# `1.0` means `5` lines scroll in `tmux`
mouse-scroll-multiplier = 1.0
