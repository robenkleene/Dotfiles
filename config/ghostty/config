keybind = global:opt+escape=toggle_quick_terminal

# font-family = "Berkeley Mono"
# font-family = "Consolas"

# font-size = 13

font-family = "SF Mono"

# Old adjustments probably not necessary anymore
# font-style = "Medium"
# adjust-cell-width = "-5%"
# adjust-cell-height = "3%"

# Font smoothing with SF Mono looks better on large Retina monitors, without it
# the strokes look too thin
font-thicken = true
# adjust-cell-width = "-3%"
adjust-cell-height = "12%"

# macos-titlebar-style = native
theme = robenkleene

# Turn on every alert option
bell-features = attention,audio,system,title,border

# The blur setting has trouble sticking on 1.1.3
# Try again on a new version
# background-opacity = 0.9
# background-blur = true

# Cursor
# `shell-integration` overrides the cursor
# shell-integration-features = no-cursor
# cursor-style = block
# cursor-style-blink = false

# Set number of lines to scroll per mouse wheel tick
# The default is `3` which results in `15` lines scrolling in `tmux`
# `1.0` means `5` lines scroll in `tmux`
mouse-scroll-multiplier = 1.0
