" set guifont=Berkeley\ Mono:h13
" set guifont=Consolas:h14

" This matches Ghostty rendering more closely
" set guifont=SF\ Mono\ Medium:h13
" This matches Apple Terminal more closely
set guifont=SF\ Mono:h13

" `linespace=2` is a better amount of space, but it makes the the status bar
" not vertically center aligned.
set linespace=1

" Initial window size for new empty documents, files opened as arguments keep
" the default size (the last window size)
" This has to be after `guifont` and `linespace` because they change the size
if argc() == 0
  set lines=24 columns=80
endif

" Swap the MacVim defaults so `<D-w>` closes the whole window (`File.Close
" Window` runs `:conf qa`) and `<D-W>` closes the current split (`File.Close`
" runs `:conf q`). `macmenu` key bindings only work in `gvimrc`.
if has('gui_macvim')
  macmenu File.Close\ Window key=<D-w>
  macmenu File.Close key=<D-W>
endif

" Disable audible bell
autocmd GUIEnter * set vb t_vb=

" Don't use GUI tabs
set guioptions-=e

" Background & Cursor
" set background=light
" colorscheme wildcharm

function! s:ApplyColors() abort
  if &background ==# 'dark'
    " BBEdit Black
    " highlight NonText guibg=#141414
    " highlight Normal guifg=#FFFFFF guibg=#141414
    " Xcode Black
    highlight NonText guibg=#292A30
    highlight Normal guifg=#FFFFFF guibg=#292A30
  else
    " BBEdit Light
    highlight NonText guifg=#141414
    highlight Normal guifg=#141414
  endif
  " Green cursor
  highlight Cursor guibg=#00BB00
endfunction

augroup override_guicolors
  autocmd!
  autocmd ColorScheme * call s:ApplyColors()
augroup END

call s:ApplyColors()

" Setting the cursor color has to be after setting the theme
set guicursor=a:blinkon0

" Env
let $MANPATH = expand('~/.brew/share/man') . ':' . expand('~/.man') . ':' . expand('~/.man-local') . ':' . $MANPATH
let $RIPGREP_CONFIG_PATH= expand('~/.ripgreprc')

" There's an oddity in Vim, if you try this sequence:
" 1. `vim -u NONE`
" 2. `setlocal spell`
" 3. `enew`
" 4. `setlocal spell?`
" Note that spelling is *enabled* in the new buffer, this is because it seems
" like the existing buffer is partly re-used if it's empty.
" E.g., this behavior doesn't happen if `:new` is used instead of `:enew`, or
" if the first buffer is modified before trying `:enew`.
" Enabling this exasperates this oddity because it means Markdown specific
" settings get inhereted, leading to unexpected behavior.
" Trying this only in `gvimrc`
" The problem is then taking log output and pasting it into a Vim buffer will
" then have markdown filetype.
" augroup default_new_buffer_filetype
"   autocmd!
"   autocmd BufWinEnter *
"         \ if &buftype ==# ''
"         \ && &filetype ==# ''
"         \ && bufname('%') ==# ''
"         \ && line('$') == 1
"         \ && getline(1) ==# ''
"         \ | setlocal filetype=markdown
"         \ | endif
" augroup END
